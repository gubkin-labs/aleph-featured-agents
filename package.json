{
  "name": "aleph-featured-agents",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public featured agents for the Aleph platform — sync agent folders to Aleph on every push.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate-catalog.mjs",
    "quality": "node scripts/validate-catalog.mjs",
    "sync": "pnpm dlx @gubkin-labs/aleph-cli@latest agents sync agents --no-enable"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
